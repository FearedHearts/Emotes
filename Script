local function RefreshAllStars()
	for _, Emote in pairs(Emotes) do
		local EmoteButton = Frame:FindFirstChild(tostring(Emote.id))
		if EmoteButton then
			local Star = EmoteButton:FindFirstChild("favorite")
			local IsFav = table.find(FavoritedEmotes, Emote.id) ~= nil
			if Star then
				Star.Image = IsFav and FavoriteOn or FavoriteOff
			end
			EmoteButton.LayoutOrder = Emote.sort[CurrentSort] + (IsFav and 0 or #Emotes)
			if Settings.ShowFavoritesOnly then
				EmoteButton.Visible = IsFav
			end
		end
	end
end

local function SaveSettingsFile()
	pcall(function()
		local toSave = {}
		for k, v in pairs(Settings) do toSave[k] = v end
		toSave.CurrentSort = CurrentSort
		toSave.Presets = Presets
		WriteFileFunc("EmoteSettings.txt", HttpService:JSONEncode(toSave))
	end)
end

local function RefreshPresetList()
	if not FavoritesList then return end
	for _, Child in pairs(FavoritesList:GetChildren()) do
		if Child:IsA("GuiObject") then
			Child:Destroy()
		end
	end
	if #Presets == 0 then
		local Empty = Instance.new("TextLabel")
		Empty.Size = UDim2.new(1, -10, 0, 24)
		Empty.Position = UDim2.new(0, 5, 0, 4)
		Empty.BackgroundTransparency = 1
		Empty.Text = "No presets yet. Star some emotes, name it, hit Save."
		Empty.TextColor3 = Color3.new(1, 1, 1)
		Empty.TextScaled = true
		Empty.TextWrapped = true
		Empty.Font = Enum.Font.Gotham
		Empty.TextXAlignment = Enum.TextXAlignment.Left
		Empty.BorderSizePixel = 0
		Corner:Clone().Parent = Empty
		Empty.Parent = FavoritesList
		return
	end
	local Y = 4
	for Index, Preset in pairs(Presets) do
		local Row = Instance.new("TextButton")
		Row.Size = UDim2.new(1, -50, 0, 24)
		Row.Position = UDim2.new(0, 4, 0, Y)
		Row.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		Row.TextColor3 = Color3.new(1, 1, 1)
		Row.Text = Preset.name
		Row.TextScaled = true
		Row.TextTruncate = Enum.TextTruncate.AtEnd
		Row.Font = Enum.Font.Gotham
		Row.BorderSizePixel = 0
		Corner:Clone().Parent = Row
		Row.Parent = FavoritesList
		Row.MouseButton1Click:Connect(function()
			local raw = ReadFileFunc(Preset.file)
			if not raw then
				SendNotification("Presets", "Could not read " .. Preset.file)
				return
			end
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if not ok or type(decoded) ~= "table" then
				SendNotification("Presets", Preset.file .. " is corrupt.")
				return
			end
			local New = {}
			for _, Id in pairs(decoded) do
				if type(Id) == "number" then
					table.insert(New, Id)
				end
			end
			FavoritedEmotes = New
			WriteFileFunc("FavoritedEmotes.txt", HttpService:JSONEncode(FavoritedEmotes))
			RefreshAllStars()
			if Settings.ShowFavoritesOnly then
				SortEmotes()
			end
			SendNotification("Presets", "Loaded " .. Preset.name)
		end)
		local Remove = Instance.new("TextButton")
		Remove.Size = UDim2.new(0, 36, 0, 24)
		Remove.Position = UDim2.new(1, -40, 0, Y)
		Remove.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		Remove.TextColor3 = Color3.new(1, 1, 1)
		Remove.Text = "X"
		Remove.TextScaled = true
		Remove.Font = Enum.Font.GothamBold
		Remove.BorderSizePixel = 0
		Corner:Clone().Parent = Remove
		Remove.Parent = FavoritesList
		Remove.MouseButton1Click:Connect(function()
			if delfile then
				pcall(delfile, Preset.file)
			end
			for i = #Presets, 1, -1 do
				if Presets[i].file == Preset.file then
					table.remove(Presets, i)
				end
			end
			SaveSettingsFile()
			RefreshPresetList()
		end)
		Y = Y + 28
	end
end

local function SavePreset(Name)
	local Clean = tostring(Name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if Clean == "" then
		SendNotification("Presets", "Give the preset a name.")
		return
	end
	for _, Preset in pairs(Presets) do
		if Preset.name == Clean then
			WriteFileFunc(Preset.file, HttpService:JSONEncode(FavoritedEmotes))
			SendNotification("Presets", "Updated " .. Clean)
			RefreshPresetList()
			return
		end
	end
	local File = "preset" .. tostring(#Presets + 1) .. ".txt"
	local Ok = WriteFileFunc(File, HttpService:JSONEncode(FavoritedEmotes))
	if not Ok then
		SendNotification("Presets", "Could not write " .. File)
		return
	end
	table.insert(Presets, { name = Clean, file = File })
	SaveSettingsFile()
	SendNotification("Presets", "Saved " .. Clean .. " (" .. #FavoritedEmotes .. " favorites)")
	RefreshPresetList()
end

