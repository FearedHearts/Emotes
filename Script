local function SortEmotes()
	for i,Emote in pairs(Emotes) do
		local EmoteButton = Frame:FindFirstChild(Emote.id)
		if not EmoteButton then
			continue
		end
		local IsFavorited = table.find(FavoritedEmotes, Emote.id)
		if Settings.ShowFavoritesOnly and not IsFavorited then
			EmoteButton.Visible = false
		else
			EmoteButton.Visible = true
			EmoteButton.LayoutOrder = Emote.sort[CurrentSort] + ((IsFavorited and 0) or #Emotes)
		end
		if EmoteButton:FindFirstChild("number") then
			EmoteButton.number.Text = Emote.sort[CurrentSort]
		end
	end
end

local function SetFavorite(EmoteId, Want)
	local Index = table.find(FavoritedEmotes, EmoteId)
	if Want and not Index then
		table.insert(FavoritedEmotes, EmoteId)
	elseif not Want and Index then
		table.remove(FavoritedEmotes, Index)
	end
	WriteFileFunc("FavoritedEmotes.txt", HttpService:JSONEncode(FavoritedEmotes))
	local EmoteButton = Frame:FindFirstChild(tostring(EmoteId))
	if EmoteButton then
		local Star = EmoteButton:FindFirstChild("favorite")
		if Star then
			Star.Image = Want and FavoriteOn or FavoriteOff
		end
		for _, Emote in pairs(Emotes) do
			if Emote.id == EmoteId then
				EmoteButton.LayoutOrder = Emote.sort[CurrentSort] + (Want and 0 or #Emotes)
				break
			end
		end
		if Settings.ShowFavoritesOnly and not Want then
			EmoteButton.Visible = false
		end
	end
end

