local function PresetSignature()
	local Parts = { tostring(#Presets), tostring(#FavoritedEmotes) }
	for _, Preset in pairs(Presets) do
		Parts[#Parts + 1] = Preset.name .. ":" .. tostring(Preset.file)
	end
	return table.concat(Parts, "|")
end

local LastPresetSignature = PresetSignature()

local function UpdatePresetPanel()
	local Sig = PresetSignature()
	if Sig ~= LastPresetSignature then
		LastPresetSignature = Sig
		RefreshPresetList()
	end
	PresetCountLabel.Text = "Favorites: " .. tostring(#FavoritedEmotes)
		.. "  |  Presets: " .. tostring(#Presets)
end

